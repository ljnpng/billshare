# API Configuration
# 获取你的Claude API Key: https://console.anthropic.com/
# 获取你的Groq API Key: https://console.groq.com/
# 获取你的DeepSeek API Key: https://platform.deepseek.com/

# Claude API Key (用于后端 API 路由)
CLAUDE_API_KEY="your-claude-api-key-here"

# Groq API Key (用于后端 API 路由)
GROQ_API_KEY="your-groq-api-key-here"

# OpenAI-compatible API（例如 DeepSeek）
OPENAI_COMPATIBLE_BASE_URL="https://api.deepseek.com/v1"
OPENAI_COMPATIBLE_API_KEY="your-openai-compatible-api-key-here"
OPENAI_COMPATIBLE_MODEL="deepseek-v4-flash-vision-exp"

# AI Provider (选择使用哪个 AI 服务: claude、groq 或 openai-compatible)
AI_PROVIDER="claude"

# 注意：在生产环境中，不要将API key直接暴露在前端代码中
# 建议使用后端代理API调用，或者使用环境变量管理

# 应用配置 (可选)
NEXT_PUBLIC_APP_NAME=BillShare费用分摊
NEXT_PUBLIC_APP_VERSION=2.0.0

# 开发环境配置 (可选)
NODE_ENV=development

# 存储后端：memory（默认）、cloudflare 或 redis
STORAGE_PROVIDER="memory"

# Cloudflare KV 配置（STORAGE_PROVIDER=cloudflare 时必填）
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_KV_NAMESPACE_ID="your-kv-namespace-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Redis 配置（STORAGE_PROVIDER=redis 时必填）
REDIS_HOST="your-redis-host-here"
REDIS_PORT="your-redis-port-here"
REDIS_PASSWORD="your-redis-password-here"
